<!-- Hero Section con Storytelling de Origen -->
<section class="relative bg-coffee-950 text-white overflow-hidden py-24 lg:py-32">
    <div class="absolute inset-0 opacity-30 mix-blend-overlay">
        <img src="https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=1600&q=80" alt="Cafetal en las montañas" class="w-full h-full object-cover">
    </div>
    <div class="absolute inset-0 bg-gradient-to-r from-coffee-950 via-coffee-950/80 to-transparent"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl space-y-6">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-500/20 border border-amber-400/30 text-amber-300 text-xs font-semibold tracking-wider uppercase">
                <i class="fa-solid fa-award"></i> Café de Especialidad &bull; Cosecha 2026
            </div>
            <h1 class="font-serif text-4xl sm:text-6xl font-bold tracking-tight text-white leading-tight">
                El alma de la montaña en cada taza.
            </h1>
            <p class="text-lg text-stone-300 font-light leading-relaxed">
                Somos caficultores de tercera generación. Cosechamos cerezas seleccionadas a mano sobre los 1,850 metros de altura, tostadas semanalmente para preservar notas florales y frutales irrepetibles.
            </p>
            <div class="pt-4 flex flex-wrap gap-4">
                <a href="/tienda" class="inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-500 text-stone-950 font-bold px-7 py-3.5 rounded-full shadow-lg shadow-amber-900/30 transition transform hover:-translate-y-0.5">
                    <span>Comprar Microlotes</span>
                    <i class="fa-solid fa-arrow-right text-sm"></i>
                </a>
                <a href="/origen" class="inline-flex items-center gap-2 bg-stone-900/80 hover:bg-stone-800 text-white font-semibold px-7 py-3.5 rounded-full border border-stone-700 transition">
                    <i class="fa-solid fa-mountain"></i>
                    <span>Conocer la Finca</span>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Indicadores de Calidad de la Finca -->
<section class="bg-white border-b border-stone-200 py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center divide-x divide-stone-100">
            <div class="p-4">
                <div class="font-serif text-3xl sm:text-4xl font-bold text-coffee-900">1,850 m</div>
                <div class="text-xs uppercase font-semibold tracking-widest text-stone-500 mt-1">Altitud Promedio</div>
            </div>
            <div class="p-4">
                <div class="font-serif text-3xl sm:text-4xl font-bold text-amber-600">88.5+</div>
                <div class="text-xs uppercase font-semibold tracking-widest text-stone-500 mt-1">Puntaje Catación SCA</div>
            </div>
            <div class="p-4">
                <div class="font-serif text-3xl sm:text-4xl font-bold text-coffee-900">100%</div>
                <div class="text-xs uppercase font-semibold tracking-widest text-stone-500 mt-1">Trazabilidad de Lote</div>
            </div>
            <div class="p-4">
                <div class="font-serif text-3xl sm:text-4xl font-bold text-origin-600">Sombra</div>
                <div class="text-xs uppercase font-semibold tracking-widest text-stone-500 mt-1">Cultivo Agroforestal</div>
            </div>
        </div>
    </div>
</section>

<!-- Microlotes Destacados -->
<section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
            <span class="text-xs font-bold text-amber-700 uppercase tracking-widest">Ediciones Limitadas</span>
            <h2 class="font-serif text-3xl sm:text-4xl font-bold text-stone-900 mt-1">Microlotes de Temporada</h2>
        </div>
        <a href="/tienda" class="text-coffee-800 font-semibold hover:text-amber-700 transition flex items-center gap-1 mt-4 md:mt-0 text-sm">
            Ver todo el catálogo (<%= products.length %> lotes) <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% featuredProducts.forEach(function(product) { %>
            <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-stone-200/80 flex flex-col group">
                <!-- Imagen con Badge SCA -->
                <div class="relative h-64 overflow-hidden bg-stone-100">
                    <img src="<%= product.image_url %>" alt="<%= product.name %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                    <div class="absolute top-4 left-4 bg-coffee-950/90 text-amber-300 text-xs font-bold px-3 py-1 rounded-full backdrop-blur">
                        <i class="fa-solid fa-star text-[10px]"></i> <%= product.sca_score %> SCA
                    </div>
                    <div class="absolute top-4 right-4 bg-white/90 text-stone-800 text-[11px] font-semibold px-2.5 py-1 rounded-full shadow-sm">
                        <%= product.process %>
                    </div>
                </div>

                <!-- Detalles -->
                <div class="p-6 flex-grow flex flex-col justify-between">
                    <div>
                        <div class="text-xs font-semibold text-stone-400 uppercase tracking-wider mb-1">
                            Variedad <%= product.variety %> &bull; <%= product.altitude_masl %> m.s.n.m.
                        </div>
                        <h3 class="font-serif text-xl font-bold text-stone-900 mb-2">
                            <a href="/producto/<%= product.slug %>" class="hover:text-amber-700 transition">
                                <%= product.name %>
                            </a>
                        </h3>
                        <p class="text-xs text-amber-900 bg-amber-50 rounded-lg p-2.5 border border-amber-200/50 mb-4 font-medium">
                            <i class="fa-solid fa-mug-saucer mr-1 text-amber-600"></i> <%= product.tasting_notes %>
                        </p>
                        <p class="text-sm text-stone-600 line-clamp-2 mb-4">
                            <%= product.description %>
                        </p>
                    </div>

                    <div class="pt-4 border-t border-stone-100 flex items-center justify-between">
                        <div>
                            <span class="text-xs text-stone-400 block">Bolsa 250g</span>
                            <span class="font-serif text-xl font-bold text-coffee-950">$<%= product.price.toLocaleString('es-CO') %> COP</span>
                        </div>
                        <a href="/producto/<%= product.slug %>" class="bg-coffee-900 hover:bg-amber-600 hover:text-stone-950 text-white text-xs font-bold uppercase tracking-wider px-4 py-2.5 rounded-full transition">
                            Personalizar
                        </a>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>
</section>

<!-- Sección Origen y Caficultura -->
<section id="proceso" class="bg-origin-50 py-20 border-t border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="space-y-6">
                <span class="text-xs font-bold text-origin-600 uppercase tracking-widest">Nuestra Filosofía</span>
                <h2 class="font-serif text-3xl sm:text-5xl font-bold text-stone-900 leading-tight">
                    De la mata al tostador, sin intermediarios.
                </h2>
                <p class="text-stone-600 leading-relaxed">
                    Creemos en el pago justo, el bienestar de nuestros recolectores y el respeto por el ecosistema de montaña. Cada microlote cuenta con trazabilidad total: fecha de recolección, curvas de fermentación y tueste específico para cada variedad.
                </p>
                <div class="space-y-4">
                    <div class="flex items-start gap-3">
                        <div class="w-8 h-8 rounded-full bg-origin-600 text-white flex items-center justify-center shrink-0 mt-0.5">
                            <i class="fa-solid fa-leaf text-xs"></i>
                        </div>
                        <div>
                            <h4 class="font-semibold text-stone-900 text-sm">Recolección Selectiva en Grano Óptimo</h4>
                            <p class="text-xs text-stone-500">Medición con refractómetro brix para cosechar solo granos con máxima concentración de azúcares naturales.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <div class="w-8 h-8 rounded-full bg-origin-600 text-white flex items-center justify-center shrink-0 mt-0.5">
                            <i class="fa-solid fa-flask-vial text-xs"></i>
                        </div>
                        <div>
                            <h4 class="font-semibold text-stone-900 text-sm">Fermentaciones de Precisión</h4>
                            <p class="text-xs text-stone-500">Maceraciones carbónicas, anaeróbicas y procesos Honey en tanques de acero con control de temperatura y pH.</p>
                        </div>
                    </div>
                </div>
                <div class="pt-4">
                    <a href="/origen" class="inline-flex items-center gap-2 text-sm font-bold text-origin-700 hover:text-origin-800">
                        <span>Descubre el recorrido completo de nuestra finca</span>
                        <i class="fa-solid fa-arrow-right text-xs"></i>
                    </a>
                </div>
            </div>

            <div class="relative">
                <div class="rounded-3xl overflow-hidden shadow-2xl border-4 border-white">
                    <img src="https://images.unsplash.com/photo-1611162618071-b39a2ec055fb?auto=format&fit=crop&w=800&q=80" alt="Cerezas de café maduras" class="w-full h-auto object-cover">
                </div>
            </div>
        </div>
    </div>
</section>
