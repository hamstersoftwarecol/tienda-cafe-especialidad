<div class="py-12 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row justify-between sm:items-center pb-6 border-b border-stone-200 mb-8 gap-4">
        <div>
            <span class="text-xs font-bold text-amber-700 uppercase tracking-widest">Mi Perfil</span>
            <h1 class="font-serif text-3xl font-bold text-stone-900 mt-1">Hola, <%= user.name %></h1>
            <p class="text-xs text-stone-500"><%= user.email %></p>
        </div>
        <div class="flex items-center gap-3">
            <% if (user.role === 'admin') { %>
                <a href="/admin" class="bg-amber-600 hover:bg-amber-500 text-stone-950 font-bold text-xs uppercase px-4 py-2.5 rounded-full transition flex items-center gap-1.5">
                    <i class="fa-solid fa-lock"></i> Panel Administrador
                </a>
            <% } %>
            <a href="/logout" class="bg-stone-200 hover:bg-rose-100 hover:text-rose-700 text-stone-700 font-bold text-xs uppercase px-4 py-2.5 rounded-full transition">
                Cerrar Sesión
            </a>
        </div>
    </div>

    <h2 class="font-serif text-2xl font-bold text-stone-900 mb-6 flex items-center gap-2">
        <i class="fa-solid fa-box-archive text-amber-600"></i> Historial de Pedidos de Café
    </h2>

    <% if (orders.length === 0) { %>
        <div class="bg-white rounded-3xl p-10 text-center border border-stone-200">
            <p class="text-stone-500 text-sm mb-4">Aún no has realizado pedidos de café de especialidad.</p>
            <a href="/tienda" class="inline-block bg-coffee-900 text-white font-bold text-xs uppercase px-6 py-3 rounded-full hover:bg-amber-600 transition">
                Ver Cafés Disponibles
            </a>
        </div>
    <% } else { %>
        <div class="space-y-6">
            <% orders.forEach(function(order) { %>
                <div class="bg-white rounded-3xl p-6 sm:p-8 border border-stone-200 shadow-sm space-y-4">
                    <div class="flex flex-wrap justify-between items-start gap-4 pb-4 border-b border-stone-100">
                        <div>
                            <span class="font-bold text-stone-900 text-base">Pedido #<%= order.id %></span>
                            <span class="text-stone-400 text-xs block"><%= new Date(order.created_at).toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
                        </div>
                        <div class="text-right">
                            <span class="font-serif font-bold text-lg text-coffee-950 block">$<%= order.total.toLocaleString('es-CO') %> COP</span>
                            <span class="bg-amber-100 text-amber-900 font-bold text-[10px] uppercase px-3 py-1 rounded-full inline-block mt-1">
                                <%= order.status %>
                            </span>
                        </div>
                    </div>

                    <div class="text-xs text-stone-600">
                        <strong>Dirección de entrega:</strong> <%= order.shipping_address %> &bull; <strong>Tel:</strong> <%= order.phone %>
                    </div>

                    <!-- Items del pedido -->
                    <div class="bg-stone-50 rounded-2xl p-4 divide-y divide-stone-200 text-xs">
                        <% order.items.forEach(function(item) { %>
                            <div class="py-2 first:pt-0 last:pb-0 flex justify-between items-center">
                                <div>
                                    <span class="font-bold text-stone-800"><%= item.product_name %></span>
                                    <span class="text-stone-500 block"><%= item.weight_grams %>g &bull; <%= item.grind_type %></span>
                                </div>
                                <div class="text-right">
                                    <span class="font-medium text-stone-700">Cant: <%= item.quantity %></span>
                                    <span class="font-bold text-stone-900 block">$<%= (item.unit_price * item.quantity).toLocaleString('es-CO') %></span>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>
</div>
