<div class="py-12 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="font-serif text-3xl font-bold text-stone-900 mb-8">Finalizar Pedido</h1>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
        <!-- Formulario de Envío -->
        <div class="md:col-span-2 bg-white rounded-3xl p-8 border border-stone-200 shadow-sm space-y-6">
            <h2 class="font-serif text-xl font-bold text-stone-900 flex items-center gap-2">
                <i class="fa-solid fa-location-dot text-amber-600"></i> Datos de Entrega
            </h2>

            <form action="/checkout" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-1">Nombre Completo *</label>
                    <input type="text" name="customerName" required value="<%= user ? user.name : '' %>" placeholder="Ej. Juan Pérez" class="w-full bg-stone-50 border border-stone-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-coffee-800 focus:outline-none">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-1">Correo Electrónico *</label>
                        <input type="email" name="customerEmail" required value="<%= user ? user.email : '' %>" placeholder="juan@correo.com" class="w-full bg-stone-50 border border-stone-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-coffee-800 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-1">Teléfono / Celular *</label>
                        <input type="tel" name="phone" required placeholder="310 000 0000" class="w-full bg-stone-50 border border-stone-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-coffee-800 focus:outline-none">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-1">Dirección Completa de Envío *</label>
                    <input type="text" name="shippingAddress" required placeholder="Calle, Carrera, Apto / Casa, Ciudad y Departamento" class="w-full bg-stone-50 border border-stone-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-coffee-800 focus:outline-none">
                </div>

                <!-- Método de Pago Simulado -->
                <div class="pt-4 border-t border-stone-100">
                    <label class="block text-xs font-bold uppercase tracking-wider text-stone-600 mb-3">Método de Pago</label>
                    <div class="space-y-2">
                        <label class="flex items-center gap-3 p-3.5 border-2 border-coffee-800 rounded-xl bg-coffee-50 cursor-pointer">
                            <input type="radio" name="paymentMethod" value="contraentrega" checked class="text-coffee-800">
                            <div>
                                <span class="font-bold text-sm text-stone-900 block">Pago Contra Entrega / Transferencia Bancaria</span>
                                <span class="text-xs text-stone-500">Transfiere por Bancolombia, Nequi o paga al recibir tu paquete de café</span>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="pt-4">
                    <button type="submit" class="w-full bg-coffee-900 hover:bg-amber-600 hover:text-stone-950 text-white font-bold py-4 rounded-xl shadow-lg transition flex items-center justify-center gap-2 text-sm">
                        <span>Confirmar y Enviar Pedido a Finca</span>
                        <i class="fa-solid fa-check text-xs"></i>
                    </button>
                </div>
            </form>
        </div>

        <!-- Resumen del Carrito -->
        <div class="bg-stone-100 rounded-3xl p-6 border border-stone-200 space-y-4">
            <h3 class="font-serif font-bold text-stone-900">Tu Cesta (<%= cart.length %>)</h3>
            <div class="space-y-3 text-xs divide-y divide-stone-200">
                <% cart.forEach(function(item) { %>
                    <div class="pt-2 flex justify-between items-start">
                        <div>
                            <span class="font-bold text-stone-800 block"><%= item.name %></span>
                            <span class="text-stone-500"><%= item.weight %>g &bull; <%= item.quantity %> un.</span>
                        </div>
                        <span class="font-bold text-stone-900">$<%= (item.price * item.quantity).toLocaleString('es-CO') %></span>
                    </div>
                <% }); %>
            </div>
            <div class="pt-4 border-t border-stone-200 flex justify-between items-baseline font-serif">
                <span class="font-bold text-stone-700">Total:</span>
                <span class="font-bold text-xl text-coffee-950">$<%= total.toLocaleString('es-CO') %> COP</span>
            </div>
        </div>
    </div>
</div>
