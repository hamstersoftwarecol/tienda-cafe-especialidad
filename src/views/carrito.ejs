<div class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="font-serif text-3xl font-bold text-stone-900 mb-8">Tu Carrito de Café</h1>

    <% if (!cart || cart.length === 0) { %>
        <div class="bg-white rounded-3xl p-12 text-center border border-stone-200 max-w-xl mx-auto shadow-sm">
            <div class="w-16 h-16 bg-stone-100 rounded-full flex items-center justify-center text-stone-400 text-2xl mx-auto mb-4">
                <i class="fa-solid fa-mug-hot"></i>
            </div>
            <h3 class="font-serif text-xl font-bold text-stone-800 mb-2">Tu carrito está vacío</h3>
            <p class="text-sm text-stone-500 mb-6">Explora nuestros microlotes de café recién cosechados y selecciona tu molienda favorita.</p>
            <a href="/tienda" class="inline-flex items-center gap-2 bg-coffee-900 text-white font-bold text-sm px-6 py-3 rounded-full hover:bg-amber-600 hover:text-stone-950 transition">
                <span>Ver Catálogo de Cafés</span>
                <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
            <!-- Lista de Productos en el Carrito -->
            <div class="lg:col-span-2 bg-white rounded-3xl p-6 sm:p-8 border border-stone-200 shadow-sm space-y-6">
                <% cart.forEach(function(item, index) { %>
                    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between pb-6 border-b border-stone-100 gap-4">
                        <div class="flex items-center gap-4">
                            <img src="<%= item.image_url %>" alt="<%= item.name %>" class="w-20 h-20 object-cover rounded-2xl bg-stone-100">
                            <div>
                                <h3 class="font-serif font-bold text-stone-900 text-base"><%= item.name %></h3>
                                <p class="text-xs text-stone-500 mt-0.5">
                                    <span class="font-semibold text-coffee-800"><%= item.weight %>g</span> &bull; <%= item.grind %>
                                </p>
                                <span class="text-xs text-stone-400 block mt-1">Precio unitario: $<%= item.price.toLocaleString('es-CO') %> COP</span>
                            </div>
                        </div>

                        <div class="flex items-center justify-between w-full sm:w-auto gap-6">
                            <span class="font-serif font-bold text-lg text-stone-900">
                                $<%= (item.price * item.quantity).toLocaleString('es-CO') %> COP
                            </span>
                            <span class="text-xs bg-stone-100 px-3 py-1.5 rounded-full font-bold text-stone-700">
                                Cant: <%= item.quantity %>
                            </span>
                            <form action="/carrito/eliminar" method="POST">
                                <input type="hidden" name="index" value="<%= index %>">
                                <button type="submit" class="text-stone-400 hover:text-rose-600 transition p-2" title="Eliminar ítem">
                                    <i class="fa-regular fa-trash-can"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                <% }); %>

                <div class="pt-2 flex justify-between items-center">
                    <a href="/tienda" class="text-xs font-semibold text-coffee-800 hover:underline flex items-center gap-1">
                        <i class="fa-solid fa-arrow-left text-[10px]"></i> Seguir explorando cafés
                    </a>
                </div>
            </div>

            <!-- Resumen de Compra -->
            <div class="bg-white rounded-3xl p-6 sm:p-8 border border-stone-200 shadow-sm space-y-6">
                <h2 class="font-serif text-xl font-bold text-stone-900">Resumen del Pedido</h2>

                <div class="space-y-3 text-sm border-b border-stone-100 pb-4">
                    <div class="flex justify-between text-stone-600">
                        <span>Subtotal Cafés</span>
                        <span>$<%= total.toLocaleString('es-CO') %> COP</span>
                    </div>
                    <div class="flex justify-between text-stone-600">
                        <span>Envío Nacional Directo de Finca</span>
                        <span class="text-emerald-700 font-semibold">Gratis</span>
                    </div>
                </div>

                <div class="flex justify-between items-baseline">
                    <span class="font-serif font-bold text-lg text-stone-900">Total a Pagar</span>
                    <span class="font-serif font-bold text-2xl text-coffee-950">$<%= total.toLocaleString('es-CO') %> COP</span>
                </div>

                <a href="/checkout" class="w-full bg-coffee-900 hover:bg-amber-600 hover:text-stone-950 text-white font-bold py-4 rounded-xl shadow-lg transition flex items-center justify-center gap-2 text-center text-sm">
                    <span>Continuar al Checkout</span>
                    <i class="fa-solid fa-lock text-xs"></i>
                </a>

                <div class="text-[11px] text-stone-400 text-center space-y-1">
                    <p><i class="fa-solid fa-truck-fast mr-1"></i> Despachos los martes y jueves post-tueste</p>
                    <p><i class="fa-solid fa-shield-halved mr-1"></i> Compra protegida y segura</p>
                </div>
            </div>
        </div>
    <% } %>
</div>
