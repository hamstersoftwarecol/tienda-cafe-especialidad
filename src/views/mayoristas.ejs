<section class="py-16 bg-origin-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl space-y-4">
            <span class="text-xs font-bold text-amber-300 uppercase tracking-widest">Canal Mayorista & Cafeterías</span>
            <h1 class="font-serif text-4xl sm:text-5xl font-bold">Café de Especialidad para tu Negocio</h1>
            <p class="text-stone-200 text-base leading-relaxed">
                Abastecemos a cafeterías de especialidad, tostadores, hoteles boutique y empresas con microlotes trazables directamente desde nuestra finca en sacos verdes o café tostado en bultos de 5kg y 10kg.
            </p>
        </div>
    </div>
</section>

<section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <!-- Beneficios B2B -->
        <div class="space-y-8">
            <div>
                <span class="text-xs font-bold text-amber-700 uppercase tracking-widest">¿Por qué trabajar con nosotros?</span>
                <h2 class="font-serif text-3xl font-bold text-stone-900 mt-1">Trato directo con el productor agrícola</h2>
            </div>

            <div class="space-y-6 text-sm">
                <div class="flex gap-4">
                    <div class="w-10 h-10 rounded-2xl bg-amber-100 text-amber-800 flex items-center justify-center shrink-0">
                        <i class="fa-solid fa-scale-balanced"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-stone-900">Precios Transparentes por Volumen</h4>
                        <p class="text-stone-600 mt-1">Precios escalonados a partir de 10 kg en café tostado o sacos de 35kg / 70kg en café pergamino y verde con ficha técnica SCA.</p>
                    </div>
                </div>

                <div class="flex gap-4">
                    <div class="w-10 h-10 rounded-2xl bg-origin-100 text-origin-800 flex items-center justify-center shrink-0">
                        <i class="fa-solid fa-sliders"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-stone-900">Perfiles de Tueste a la Medida</h4>
                        <p class="text-stone-600 mt-1">Desarrollamos la curva de tueste perfecta para tu máquina de espresso comercial o para tu línea de filtrados de la casa.</p>
                    </div>
                </div>

                <div class="flex gap-4">
                    <div class="w-10 h-10 rounded-2xl bg-coffee-100 text-coffee-800 flex items-center justify-center shrink-0">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-stone-900">Capacitación y Calibración para Baristas</h4>
                        <p class="text-stone-600 mt-1">Acompañamos a tu equipo en la calibración inicial del molino y la extracción para garantizar consistencia en cada servicio.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Formulario de Cotización -->
        <div class="bg-white rounded-3xl p-8 border border-stone-200 shadow-xl space-y-6">
            <div>
                <h3 class="font-serif text-2xl font-bold text-stone-900">Solicitar Lista de Precios B2B</h3>
                <p class="text-xs text-stone-500 mt-1">Déjanos los datos de tu negocio y te enviaremos nuestro catálogo de cosecha con muestras de catación.</p>
            </div>

            <form action="/mayoristas" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">Nombre de Contacto *</label>
                    <input type="text" name="name" required placeholder="Ej. Andrés Gómez" class="w-full bg-stone-50 border border-stone-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-coffee-800 focus:outline-none">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">Nombre de la Cafetería / Empresa *</label>
                        <input type="text" name="businessName" required placeholder="Ej. Café Botánico" class="w-full bg-stone-50 border border-stone-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-coffee-800 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">Ciudad *</label>
                        <input type="text" name="city" required placeholder="Ej. Bogotá, Medellín, Cali..." class="w-full bg-stone-50 border border-stone-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-coffee-800 focus:outline-none">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">Correo Electrónico *</label>
                        <input type="email" name="email" required placeholder="contacto@tuempresa.com" class="w-full bg-stone-50 border border-stone-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-coffee-800 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">Teléfono / WhatsApp *</label>
                        <input type="tel" name="phone" required placeholder="310 000 0000" class="w-full bg-stone-50 border border-stone-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-coffee-800 focus:outline-none">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">Consumo mensual aproximado</label>
                    <select name="volume" class="w-full bg-stone-50 border border-stone-300 rounded-xl p-3 text-sm font-medium focus:ring-2 focus:ring-coffee-800 focus:outline-none">
                        <option value="10-25 kg">10 a 25 kg al mes</option>
                        <option value="25-50 kg">25 a 50 kg al mes</option>
                        <option value="50-100 kg">50 a 100 kg al mes</option>
                        <option value="+100 kg o Sacos Verdes">+100 kg o Sacos de Café Verde</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">Mensaje o Variedades de Interés</label>
                    <textarea name="message" rows="3" placeholder="¿Buscas café para espresso base, filtrados exóticos, o tostado personalizado?" class="w-full bg-stone-50 border border-stone-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-coffee-800 focus:outline-none"></textarea>
                </div>

                <button type="submit" class="w-full bg-coffee-900 hover:bg-amber-600 hover:text-stone-950 text-white font-bold text-xs uppercase py-4 rounded-xl shadow-md transition">
                    Enviar Solicitud Mayorista
                </button>
            </form>
        </div>
    </div>
</section>
