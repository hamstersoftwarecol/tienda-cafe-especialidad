<div class="py-12 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-8 flex items-center justify-between">
        <div>
            <span class="text-xs font-bold text-amber-700 uppercase tracking-widest">Panel de Administración</span>
            <h1 class="font-serif text-3xl font-bold text-stone-900 mt-1">Registrar Nuevo Lote de Café</h1>
        </div>
        <a href="/admin" class="text-xs font-bold text-stone-600 hover:text-stone-900 bg-stone-200 px-4 py-2 rounded-full transition">
            <i class="fa-solid fa-arrow-left mr-1"></i> Volver al Panel
        </a>
    </div>

    <div class="bg-white rounded-3xl p-8 border border-stone-200 shadow-sm">
        <form action="/admin/productos/nuevo" method="POST" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Nombre del Producto -->
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">Nombre Comercial del Lote *</label>
                    <input type="text" name="name" required placeholder="Ej. Geisha Black Honey Finca La Esperanza" class="w-full bg-stone-50 border border-stone-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-coffee-800 focus:outline-none">
                </div>

                <!-- Slug único -->
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">Slug URL (Único) *</label>
                    <input type="text" name="slug" required placeholder="geisha-black-honey-esperanza" class="w-full bg-stone-50 border border-stone-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-coffee-800 focus:outline-none">
                </div>

                <!-- Variedad Botánica -->
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">Variedad Botánica *</label>
                    <input type="text" name="variety" required placeholder="Ej. Geisha, Bourbon Rosado, Tabi, Caturra" class="w-full bg-stone-50 border border-stone-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-coffee-800 focus:outline-none">
                </div>

                <!-- Proceso de Beneficio -->
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">Proceso de Beneficio *</label>
                    <input type="text" name="process" required placeholder="Ej. Natural Anaeróbico 96h, Lavado Doble, Yellow Honey" class="w-full bg-stone-50 border border-stone-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-coffee-800 focus:outline-none">
                </div>

                <!-- Altitud -->
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">Altitud (m.s.n.m.) *</label>
                    <input type="number" name="altitude_masl" required placeholder="1850" class="w-full bg-stone-50 border border-stone-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-coffee-800 focus:outline-none">
                </div>

                <!-- Puntaje Catación SCA -->
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">Puntaje SCA (Q-Grader) *</label>
                    <input type="number" step="0.25" min="80" max="100" name="sca_score" required placeholder="88.5" class="w-full bg-stone-50 border border-stone-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-coffee-800 focus:outline-none">
                </div>

                <!-- Precio en COP (250g) -->
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">Precio Base 250g (COP) *</label>
                    <input type="number" name="price" required placeholder="48000" class="w-full bg-stone-50 border border-stone-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-coffee-800 focus:outline-none">
                </div>

                <!-- Stock en bolsas -->
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">Stock Inicial (Bolsas disponibles) *</label>
                    <input type="number" name="stock" required placeholder="50" class="w-full bg-stone-50 border border-stone-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-coffee-800 focus:outline-none">
                </div>
            </div>

            <!-- Notas de cata -->
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">Notas Sensoriales de Catación *</label>
                <input type="text" name="tasting_notes" required placeholder="Ej. Jazmín, Flor de Azahar, Melocotón blanco, Caramelo" class="w-full bg-stone-50 border border-stone-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-coffee-800 focus:outline-none">
            </div>

            <!-- URL de Imagen -->
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">URL de Imagen del Café</label>
                <input type="url" name="image_url" placeholder="https://images.unsplash.com/photo-..." class="w-full bg-stone-50 border border-stone-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-coffee-800 focus:outline-none">
            </div>

            <!-- Descripción -->
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">Historia y Descripción del Microlote *</label>
                <textarea name="description" rows="4" required placeholder="Describe las condiciones climáticas del lote, fecha de corte, curva de tueste recomendada..." class="w-full bg-stone-50 border border-stone-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-coffee-800 focus:outline-none"></textarea>
            </div>

            <!-- Destacado -->
            <div class="flex items-center gap-3">
                <input type="checkbox" id="is_featured" name="is_featured" value="1" class="w-4 h-4 text-coffee-800 border-stone-300 rounded">
                <label for="is_featured" class="text-xs font-bold text-stone-700 cursor-pointer">
                    Destacar en la página de inicio (Hero y sección de microlotes)
                </label>
            </div>

            <div class="pt-4 border-t border-stone-100 flex justify-end gap-4">
                <a href="/admin" class="px-6 py-3 rounded-xl border border-stone-300 text-stone-700 text-xs font-bold uppercase">
                    Cancelar
                </a>
                <button type="submit" class="bg-coffee-900 hover:bg-amber-600 hover:text-stone-950 text-white font-bold text-xs uppercase px-8 py-3.5 rounded-xl shadow-md transition">
                    Guardar y Publicar Lote
                </button>
            </div>
        </form>
    </div>
</div>
